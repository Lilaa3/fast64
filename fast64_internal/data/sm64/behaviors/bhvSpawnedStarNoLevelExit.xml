<?xml version='1.0' encoding='utf-8'?>
<behavior address="0x1300080C" readable_name="Spawned Star (No Level Exit)">
    <tags>
        <tag>COLLECTABLE</tag>
        <tag>SPECIALIZED</tag>
    </tags>
    <fields>
        <field name="Star ID" type="int" bparam="1" default="0x0">
            <description>The ID of the star, used to determine if it should be transparent (already collected). 6 is 100 coins.</description>
        </field>
        <field name="Spawn Position" type="int" bparam="2" default="0x0">
            <enums>
                <enum name="At Mario" value="0" c_name="SPAWN_STAR_POS_CUTSCENE_BP_SPAWN_AT_MARIO" />
                <enum name="Home" value="1" c_name="SPAWN_STAR_POS_CUTSCENE_BP_SPAWN_AT_HOME" />
            </enums>
        </field>
    </fields>
    <models>
        <model>star</model>
    </models>
</behavior>