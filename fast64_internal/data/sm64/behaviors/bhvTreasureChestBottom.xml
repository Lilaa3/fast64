        <tag>CHEST</tag>
        <tag>INTERACTIVE</tag>
    </tags>
    <fields>
        <field name="Open Order" type="int" bparam="2" default="0x0" />
    </fields>
    <models>
        <model>treasure_chest_base</model>
    </models>
</behavior>