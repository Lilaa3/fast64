<?xml version='1.0' encoding='utf-8'?>
<behavior address="0x13002178" readable_name="Fish">
    <description>A fish that roams the water. It constantly checks if it is still submerged; if it leaves the water (unless the 'sIn Full Water Level's flag is set), it is marked for deletion. Its movement and actions are managed via the sFishActions function array.</description>
    <tags>
        <tag>FISH</tag>
        <tag>WATER</tag>
        <tag>NPC</tag>
        <tag>ENEMY</tag>
    </tags>
    <fields>
        <field name="Spawner Type" type="int" bparam="2" default="0x0">
            <description>The type of fish to spawn and the quantity.</description>
            <enums>
                <enum name="Many Blue" value="0" c_name="FISH_SPAWNER_BP_MANY_BLUE" />
                <enum name="Few Blue" value="1" c_name="FISH_SPAWNER_BP_FEW_BLUE" />
                <enum name="Many Cyan" value="2" c_name="FISH_SPAWNER_BP_MANY_CYAN" />
                <enum name="Few Cyan" value="3" c_name="FISH_SPAWNER_BP_FEW_CYAN" />
            </enums>
        </field>
        <field name="Flags" type="bitflag" bparam="2" shift="4">
            <enums>
                <enum name="In Full Water Level" value="1" c_name="FISH_BP_FLAG_IN_FULL_WATER_LEVEL" />
            </enums>
        </field>
    </fields>
    <models>
        <model>cyan_fish</model>
        <model>fish</model>
    </models>
</behavior>