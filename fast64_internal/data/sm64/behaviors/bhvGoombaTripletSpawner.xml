<?xml version='1.0' encoding='utf-8'?>
<behavior address="0x13004770" readable_name="Goomba Triplet Spawner">
    <description>Spawns a circle of Goombas. Respawns are tracked via bitflags in oBehParams to prevent respawning killed Goombas..</description>
    <tags>
        <tag>ENEMY</tag>
        <tag>SPAWNER</tag>
    </tags>
    <fields>
        <field name="Spawned Goomba Size" type="int" bparam="2" default="0x0">
            <enums>
                <enum name="Regular" value="0" c_name="GOOMBA_SIZE_REGULAR" />
                <enum name="Huge" value="1" c_name="GOOMBA_SIZE_HUGE" />
                <enum name="Tiny" value="2" c_name="GOOMBA_SIZE_TINY" />
            </enums>
        </field>
        <field name="Extra Goombas" type="int" bparam="2" default="0x0" shift="2" />
    </fields>
</behavior>