<?xml version='1.0' encoding='utf-8'?>
<behavior name="bhvFloomba" readable_name="Floomba">
    <description>A.. 😳 variant of a Goomba. It sets oIsFloomba to TRUE and then switches to bhvGoomba.</description>
    <tags>
        <tag>ENEMY</tag>
    </tags>
    <fields>
        <field name="Size" type="int" bparam="2" default="0x0">
            <enums>
                <enum name="Regular" value="0" c_name="GOOMBA_SIZE_REGULAR" />
                <enum name="Huge" value="1" c_name="GOOMBA_SIZE_HUGE" />
                <enum name="Tiny" value="2" c_name="GOOMBA_SIZE_TINY" />
            </enums>
        </field>
        <field name="Triplet Index" type="int" bparam="2" default="0x0" shift="2" />
    </fields>
    <models>
        <model>goomba</model>
    </models>
</behavior>