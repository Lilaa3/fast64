<?xml version='1.0' encoding='utf-8'?>
<behavior address="0x13003388" readable_name="Circling Amp">
    <description>Amp enemy. Circles a point or stays fixed based on BP2. Faces Mario and oscillates vertically.</description>
    <tags>
        <tag>ENEMY</tag>
        <tag>ENVIRONMENTAL</tag>
    </tags>
    <fields>
        <field name="Rotation Radius" type="int" bparam="2" default="0x0">
            <enums>
                <enum name="200" value="0" c_name="AMP_BP_ROT_RADIUS_200" />
                <enum name="300" value="1" c_name="AMP_BP_ROT_RADIUS_300" />
                <enum name="400" value="2" c_name="AMP_BP_ROT_RADIUS_400" />
                <enum name="Fixed" value="3" c_name="AMP_BP_ROT_RADIUS_0" />
            </enums>
        </field>
    </fields>
    <models>
        <model>amp</model>
    </models>
</behavior>