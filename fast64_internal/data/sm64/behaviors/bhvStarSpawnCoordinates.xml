<?xml version='1.0' encoding='utf-8'?>
<behavior address="0x13003E64" readable_name="Star Spawn Coordinates">
    <description>An object that handles the spawning of a Power Star with a cutscene.</description>
    <tags>
        <tag>COLLECTABLE</tag>
        <tag>SPAWNER</tag>
    </tags>
    <fields>
        <field name="Star ID" type="int" bparam="1" default="0x0">
            <description>The ID of the star, used to determine if it should be transparent (already collected).</description>
        </field>
        <field name="Cutscene Type" type="int" bparam="2" default="0x0">
            <enums>
                <enum name="Default (Forced in BBH)" value="0" c_name="SPAWN_STAR_ARC_CUTSCENE_BP_DEFAULT_STAR" />
                <enum name="Hidden/Red Coin" value="1" c_name="SPAWN_STAR_ARC_CUTSCENE_BP_HIDDEN_STAR" />
            </enums>
        </field>
    </fields>
    <models>
        <model>star</model>
    </models>
</behavior>