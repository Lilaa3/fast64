<?xml version="1.0" ?>
<behavior name="0x13004d28" readable_name="TTC Elevator">
    <description>An elevator in TTC that moves up and down. The peak height is determined by its parameters.</description>
    <tags>
        <tag>PLATFORM</tag>
        <tag>TTC</tag>
    </tags>
    <fields>
        <field name="Peak Offset Multiplier" type="units" bparam="23" multiplier="100" default="4">
            <description>If 0, defaults to 500.0f.</description>
        </field>
    </fields>
    <models>
        <model>ttc_elevator_platform</model>
    </models>
</behavior>