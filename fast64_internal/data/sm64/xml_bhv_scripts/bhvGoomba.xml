<?xml version="1.0" ?>
<behavior name="0x1300472c" readable_name="Goomba">
    <description>Standard Goomba enemy. Its size, scale, gravity, and damage are determined by the 'size's parameter. It manages a basic AI state machine (Walk, Jump, Attacked Mario) and handles collision via sGoombaHitbox.</description>
    <tags>
        <tag>ENEMY</tag>
        <tag>Individual</tag>
    </tags>
    <fields>
        <field name="Size" type="int" bparam="2" mask="0x03" default="0">
            <enums>
                <enum value="0" name="Regular" c_name="GOOMBA_SIZE_REGULAR"/>
                <enum value="1" name="Huge" c_name="GOOMBA_SIZE_HUGE"/>
                <enum value="2" name="Tiny" c_name="GOOMBA_SIZE_TINY"/>
            </enums>
        </field>
        <field name="Triplet Index" type="int" bparam="2" shift="2" default="0"/> <!-- Watch out for this-->
    </fields>
    <models>
        <model>goomba</model>
    </models>
</behavior>
