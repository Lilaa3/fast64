<?xml version="1.0" ?>
<behavior name="0x1300080c" readable_name="Spawned Star (No Level Exit)">
    <tags>
        <tag>COLLECTABLE</tag>
        <tag>SPECIALIZED</tag>
    </tags>
    <fields>
        <field name="Star ID" type="int" bparam="1" default="0">
            <description>The ID of the star, used to determine if it should be transparent (already collected). 6 is 100 coins.</description>
        </field>
        <field name="Spawn Position" type="int" bparam="2" default="0">
            <enums>
                <enum value="0" name="At Mario" c_name="SPAWN_STAR_POS_CUTSCENE_BP_SPAWN_AT_MARIO"/>
                <enum value="1" name="Home" c_name="SPAWN_STAR_POS_CUTSCENE_BP_SPAWN_AT_HOME"/>
            </enums>
        </field>
    </fields>
    <models>
        <model>star</model>
    </models>
</behavior>
