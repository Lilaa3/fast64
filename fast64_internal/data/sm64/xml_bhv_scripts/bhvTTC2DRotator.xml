    <tags>
        <tag>ENVIRONMENTAL</tag>
        <tag>TTC</tag>
    </tags>
    <fields>
        <field name="Type" type="int" bparam="2" default="0">
            <enums>
                <enum value="0" name="Hand" c_name="TTC_2D_ROTATOR_BP_HAND"/>
                <enum value="1" name="Cog" c_name="TTC_2D_ROTATOR_BP_COG"/>
            </enums>
        </field>
    </fields>
    <models>
        <model>ttc_clock_hand</model>
        <model>ttc_large_gear</model>
        <model>ttc_small_gear</model>
    </models>
</behavior>
