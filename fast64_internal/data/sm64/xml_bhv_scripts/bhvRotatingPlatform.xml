<?xml version="1.0" ?>
<behavior name="0x130005b4" readable_name="Rotating Platform">
    <description>A platform that rotates around its center. Rotation speed is set via parameter 1, while parameter 2 selects the collision data and scale from a predefined table.</description>
    <tags>
        <tag>PLATAFORM</tag>
        <tag>ENVIRONMENTAL</tag>
    </tags>
    <fields>
        <field name="Rotation Speed" type="int" bparam="1" default="0"/>
        <field name="Platform Type" type="int" bparam="2" default="0">
            <enums>
                <enum value="0" name="WF" />
                <enum value="1" name="WDW"/>
            </enums>
        </field>
    </fields>
    <models>
        <model>wdw_rotating_platform</model>
        <model>wf_rotating_platform</model>
    </models>
</behavior>
