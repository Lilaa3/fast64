<?xml version="1.0" ?>
<behavior address="0x13002178" readable_name="Fish">
    <description>A fish that roams the water. It constantly checks if it is still submerged; if it leaves the water (unless the 'sIn Full Water Level's flag is set), it is marked for deletion. Its movement and actions are managed via the sFishActions function array.</description>
    <tags>
        <tag>FISH</tag>
        <tag>WATER</tag>
        <tag>NPC</tag>
        <tag>ENEMY</tag>
    </tags>
    <fields>
        <field name="Spawner Type" type="int" bparam="2" default="0">
            <description>The type of fish to spawn and the quantity.</description>
            <enums>
                <enum value="0" name="Many Blue" c_name="FISH_SPAWNER_BP_MANY_BLUE"/>
                <enum value="1" name="Few Blue" c_name="FISH_SPAWNER_BP_FEW_BLUE"/>
                <enum value="2" name="Many Cyan" c_name="FISH_SPAWNER_BP_MANY_CYAN"/>
                <enum value="3" name="Few Cyan" c_name="FISH_SPAWNER_BP_FEW_CYAN"/>
            </enums>
        </field>
        <field name="Flags" type="bitflag" bparam="2" shift="4">
            <enums>
                <enum value="1" name="In Full Water Level" c_name="FISH_BP_FLAG_IN_FULL_WATER_LEVEL"/>
            </enums>
        </field>
    </fields>
    <models>
        <model>cyan_fish</model>
        <model>fish</model>
    </models>
</behavior>