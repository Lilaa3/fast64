<?xml version="1.0" ?>
<behavior name="bhvMovingFlame" readable_name="Moving Flame">
    <description>Moving flame, a projectile that follows Mario. Can be configured to exist for only a single frame or to spawn embers as it moves.</description>
    <tags>
        <tag>ENEMY</tag>
        <tag>MOVING</tag>
        <tag>FIRE</tag>
        <tag>SUB_OBJECT</tag>
    </tags>
    <fields>
        <field name="Single Frame" type="bool" bparam="2" default="0">
            <enums>
                <enum value="0" c_name="MOVING_FLAME_BP_NORMAL"/>
                <enum value="1" c_name="MOVING_FLAME_BP_1FRAME"/>
            </enums>
        </field>
    </fields>
</behavior>
